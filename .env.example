# Local development (copy to .env — never commit .env)

QSOURCE_DB_URL=jdbc:h2:file:./data/qsource;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
QSOURCE_DB_USER=sa
QSOURCE_DB_PASSWORD=
QSOURCE_SEED=true
QSOURCE_JWT_SECRET=qsource-dev-secret-change-me-please-32chars-min

VITE_API_BASE_URL=http://localhost:8095

# MCP
QSOURCE_API_BASE_URL=http://localhost:8095
QSOURCE_API_KEY=
QSOURCE_ACTOR_NAME=mcp-agent
QSOURCE_ACTOR_SOURCE=agent

